[Desktop Entry]
Type=Application
Name=Notepad++
GenericName=Text Editor
Comment=Edit text files and source code
Keywords=text;editor;code;programming;notepad;
Exec=@NPP_EXECUTABLE@ %F
Icon=notepad-plus-plus
Terminal=false
StartupNotify=true
StartupWMClass=Notepad++
Categories=Qt;Utility;TextEditor;
MimeType=text/plain;text/x-log;text/x-readme;text/markdown;text/x-markdown;text/csv;text/tab-separated-values;text/x-c;text/x-csrc;text/x-chdr;text/x-c++;text/x-c++src;text/x-c++hdr;text/x-csharp;text/x-java;text/x-go;text/rust;text/x-python;text/x-python3;text/x-perl;application/x-perl;text/x-ruby;application/x-ruby;text/x-php;application/x-php;text/x-lua;text/x-tcl;text/x-pascal;text/x-fortran;text/x-asm;text/x-matlab;text/x-sql;application/sql;text/x-shellscript;application/x-shellscript;application/x-desktop;text/x-makefile;text/x-cmake;text/x-diff;text/x-patch;text/x-tex;text/x-bibtex;text/html;text/css;text/javascript;application/javascript;application/json;application/xml;text/xml;application/xhtml+xml;application/x-yaml;text/x-yaml;application/toml;text/x-ini;text/x-nsis;text/x-po;
Actions=new-window;

[Desktop Action new-window]
Name=New Window
Exec=@NPP_EXECUTABLE@ -multiInst
